clear
echo
echo "        ${C_HEADER}MARIOS NEW DIRECTIVE"
debug "  the best file explorer ever made"
echo

infos TODO
echo -n $C_ALT
head -n 5 .todo
echo

infos STATUS
echo -n "$C_RESET"
git status -s
echo

infos COMMANDS
help .cd | indent "- "
echo

project_name="Engine"
GLFW_ACCESS_TOKEN=1
GLFW_PLATFORM=x11
SDL_VIDEODRIVER=x11

function clean() {
  rm -rf build
}

function build() {
  clear
  mkdir -p build
  (
    cd build
    cmake .. -DCMAKE_EXPORT_COMPILE_COMMANDS=ON $@ 
    cmake --build .
  )
}

function run() {
  build $@
  (
    cd build
    ./$project_name
  )
}

function validate() {
  build $@
  (
    cd build
    #VK_INSTANCE_LAYERS=VK_LAYER_KHRONOS_validation ./$project_name
    QT_QPA_PLATFORM=xcb qrenderdoc
  )
}

function fix() {
  build -DCMAKE_BUILD_TYPE=Debug
  (
    cd build
    gdb ./$project_name -ex run -ex bt
  )
}
