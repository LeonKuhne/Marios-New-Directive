clear
echo
echo "        ${C_HEADER}MARIOS NEW DIRECTIVE"
debug "  the best file explorer ever made"
echo

infos TODO
echo -n $C_ALT
head -n 5 .todo
echo

infos STATUS
echo -n "$C_RESET"
git status -s
echo

infos COMMANDS
help .cd | indent "- "
echo

default_project="test"

function get_project {
  if [ -z "$project_name" ]; then
    project_name=$default_project
  fi
  echo $project_name
}

debug "Active Project: $C_HEADER$(get_project)"

function switch() {
  project_name=$1
  echo "Switched to project: $project_name"
}

function clean() {
  rm -rf build
}

function build() {
  clear
  find_project
  cmake -S . -B build -DNAME="$(get_project)" $@ 
  cmake --build build -j$(nproc)
}

function run() {
  build $@
  (
    cd build
    SDL_VIDEODRIVER=x11 ./$(get_project)
  )
}

function release() {
  run -DCMAKE_BUILD_TYPE=Release
}

function validate() {
  build $@
  (
    cd build
    SDL_VIDEODRIVER=x11 VK_INSTANCE_LAYERS=VK_LAYER_KHRONOS_validation ./$(get_project)
    #QT_QPA_PLATFORM=xcb qrenderdoc
  )
}

function fix() {
  build -DCMAKE_BUILD_TYPE=Debug
  (
    cd build
    gdb ./$(get_project) -ex run -ex bt
  )
}
