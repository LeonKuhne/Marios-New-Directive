clear
echo
echo "        ${C_HEADER}MARIOS NEW DIRECTIVE"
debug "  the best file explorer ever made"
echo

infos TODO
echo -n $C_ALT
head -n 5 .todo
echo

infos STATUS
echo -n "$C_RESET"
git status -s
echo

infos COMMANDS
help .cd | indent "- "
echo

project_name="Engine"

function clean() {
  rm -rf build
}

function build() {
  clear
  cmake -S . -B build $@ 
  cmake --build build -j$(nproc)
}

function run() {
  build $@
  (
    cd build
    SDL_VIDEODRIVER=x11 ./$project_name
  )
}

function release() {
  run -DCMAKE_BUILD_TYPE=Release
}

function validate() {
  build $@
  (
    cd build
    SDL_VIDEODRIVER=x11 VK_INSTANCE_LAYERS=VK_LAYER_KHRONOS_validation ./$project_name
    #QT_QPA_PLATFORM=xcb qrenderdoc
  )
}

function fix() {
  build -DCMAKE_BUILD_TYPE=Debug
  (
    cd build
    gdb ./$project_name -ex run -ex bt
  )
}
